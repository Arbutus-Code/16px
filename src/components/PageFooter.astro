---
/**
 * Shared page footer for non-editor pages (privacy, terms, error pages).
 * The editor has its own footer built into Editor.svelte.
 */
---

<footer
  class="border-t border-border px-6 py-6 text-center text-xs text-text-dim"
>
  <div class="flex items-center justify-center gap-4">
    <a
      href="/terms"
      class="hover:text-text transition-colors no-underline text-text-dim"
      >Terms of Use</a
    >
    <span class="text-border">·</span>
    <a
      href="/privacy"
      class="hover:text-text transition-colors no-underline text-text-dim"
      >Privacy Policy</a
    >
  </div>
  <p class="mt-3">
    © {new Date().getFullYear()}
    <a
      href="https://arbutuscode.ca"
      class="hover:text-text transition-colors no-underline text-text-dim"
      target="_blank"
      rel="noopener noreferrer">Arbutus Code</a
    >
  </p>
</footer>
